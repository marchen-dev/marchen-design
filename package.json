{
  "name": "marchen-design",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:serve": "pnpm dlx serve public -l 4173 --cors",
    "gen": "tsx scripts/gen.ts",
    "lint:design": "node plugin/skills/design-review/scripts/lint-design.mjs registry",
    "test": "tsx --test --test-reporter=spec \"tokens/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "smoke": "tsx scripts/smoke.ts",
    "screenshot": "playwright test",
    "screenshot:update": "playwright test --update-snapshots",
    "check:generated": "tsx scripts/check-generated.ts",
    "check:registry": "tsx scripts/check-registry.ts",
    "check": "pnpm check:generated && pnpm check:registry && pnpm lint:design && pnpm typecheck && pnpm lint && pnpm test && pnpm registry:build",
    "fork": "tsx scripts/fork-upstream.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
